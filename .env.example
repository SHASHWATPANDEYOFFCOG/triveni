# ---------------------------------------------------------------------------
# Triveni environment. EVERY value here is optional.
# `make demo`, `make eval`, `make test` and `make bench` all run to completion
# with this file exactly as-is: no keys, no network, no Razorpay account.
# ---------------------------------------------------------------------------

# --- Rails -----------------------------------------------------------------
# offline = read recorded fixtures (DEFAULT, what the demo uses)
# mcp     = call the official razorpay/razorpay-mcp-server
TRIVENI_RAILS=offline

# --- Razorpay (only read when TRIVENI_RAILS=mcp) ----------------------------
# Triveni is a read-only controller: it never calls a write tool. The allowlist
# in ingest/adapters/razorpay_mcp.py enforces that in code, and READ_ONLY=true
# asks the server to enforce it too. Belt and braces.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
READ_ONLY=true

# --- LLM -------------------------------------------------------------------
# replay = serve every call from prompts/cassettes (DEFAULT, deterministic, offline)
# record = call the live provider and write new cassettes
# off    = refuse all LLM calls; every residue row abstains into a typed exception
TRIVENI_LLM_MODE=replay
# Read from env with a documented default; never hard-coded in source.
TRIVENI_LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
# Hard budget for one run, in rupees. The gateway halts and abstains rather
# than overspending. 0 disables live calls entirely.
TRIVENI_LLM_BUDGET_INR=25

# --- Determinism -----------------------------------------------------------
TRIVENI_SEED=20260101
PYTHONHASHSEED=0

# --- Optional heavy components (OFF by default so the demo never downloads) --
TRIVENI_ENABLE_TSFM=0
TRIVENI_ENABLE_NEURAL_EMBEDDINGS=0
